# Copy this file to ".env" and fill in real values. Never commit .env.

# Port the API listens on
PORT=5000

# MongoDB Atlas connection string (include a database name at the end, e.g. /grocery)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/grocery

# Google Gemini API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# Gemini model to use (free tier). flash-lite answers in ~1-2 s; bigger "flash" models were 20 s+ on the free tier
GEMINI_MODEL=gemini-3.5-flash-lite

# If Gemini takes longer than this (milliseconds), we give up and offer manual ordering
LLM_TIMEOUT_MS=25000

# URL of the React app (allowed by CORS)
CLIENT_URL=http://localhost:5173

# Optional: only needed if you get "querySrv ECONNREFUSED" when connecting to Atlas.
# Makes Node use these public DNS servers to look up the Atlas address.
# DNS_SERVERS=8.8.8.8,1.1.1.1

# Password the shopkeeper types to log in (choose your own)
SHOPKEEPER_PASSWORD=change-me

# Secret used to sign login tokens. Any long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string
